# Variables d'environnement de Clipperie (à renseigner dans Vercel → Settings → Environment Variables).
# Ne jamais mettre de vraie valeur dans ce fichier : il est public.

# Stripe → Développeurs → Clés API → « Clé secrète » (commence par sk_test_ en mode test)
STRIPE_SECRET_KEY=

# Stripe → Développeurs → Webhooks → ton point de terminaison → « Clé secrète de signature » (commence par whsec_)
STRIPE_WEBHOOK_SECRET=
