# Variables d'environnement de Clipperie (à renseigner dans Vercel → Settings → Environment Variables).
# Ne jamais mettre de vraie valeur dans ce fichier : il est public.

# Stripe → Développeurs → Clés API → « Clé secrète » (commence par sk_test_ en mode test)
STRIPE_SECRET_KEY=

# Stripe → Développeurs → Webhooks → ton point de terminaison → « Clé secrète de signature » (commence par whsec_)
STRIPE_WEBHOOK_SECRET=

# Supabase → Project Settings → Data API → « Project URL »
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → « Publishable key » (sb_publishable_…) : visible sans risque
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → « Secret key » (sb_secret_…) : tous les droits, serveur uniquement
SUPABASE_SECRET_KEY=

# --- Moteur de découpe ---

# Vercel : Trigger.dev → projet → API keys → environnement Production (tr_prod_…)
TRIGGER_SECRET_KEY=

# Vercel ET Trigger.dev : stockage des clips sur Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Trigger.dev uniquement (Environment variables → Production)
# + NEXT_PUBLIC_SUPABASE_URL et SUPABASE_SECRET_KEY, mêmes valeurs que dans Vercel
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Proxy résidentiel pour YouTube (qui bloque les serveurs), au format http://.
# DataImpulse : http://IDENTIFIANT__cr.fr:MOT_DE_PASSE@gw.dataimpulse.com:823
# (le moteur ajoute seul une session à adresse fixe ; autre fournisseur : écrire {session}
# à l'endroit où va le numéro de session). Sans proxy, les liens YouTube échouent souvent.
YTDLP_PROXY=
